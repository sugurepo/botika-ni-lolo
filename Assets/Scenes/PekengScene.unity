  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: Ang niyog-niyogan isang malaking halamang baging na kabilang sa pamilya
    Combretaceae. Matatagpuan ito sa mga bansang tropikal tulad ng Pilipinas, India,
    Malaysia, Vietnam, at Thailand. Bukod sa kagandahan ng bulaklak nito, ang niyog-niyogan
    ay kilala rin bilang halamang gamot. Halos lahat ng bahagi ng niyog-niyogan ay
    ginagamit bilang halamang gamot.
  m_isRightToLeft: 0
