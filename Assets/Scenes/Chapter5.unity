  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: Ang sambong ay isang halamang gamot na matatagpuan sa buong Pilipinas,
    karaniwang nakikita sa bukirin, damuhan, at mga bakanteng lugar sa mababang at
    katamtamang taas. Iniinom ito bilang tsaa upang mapanatiling malusog ang daanan
    ng ihi, makatulong sa pag-alis ng uric acid, at magsilbing lunas sa mga sugat
    na may impeksiyon. Sa kasalukuyan, mabibili rin ito sa anyo ng tableta, kapsula,
    at tea bags sa mga botika at pamilihan.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fd827d572eb924341b1772a5cb611736, type: 2}
